{
  "name": "dsh-context-bridge",
  "version": "0.3.0",
  "description": "会话交接：跑到 15 轮（可配）自动强制交接——旧上下文完整归档、交接文档带原始要求与工具轨迹并指向归档、新会话用侧边栏会话名注册总线；也支持手动触发。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/ui/client.js",
    "./package.json": "./package.json"
  },
  "icon": "assets/icon.svg",
  "license": "MIT",
  "author": "YG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nevercanner/dsh-context-bridge.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "context",
    "handoff",
    "compaction",
    "agent"
  ],
  "files": [
    "src",
    "types",
    "assets",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check src/ui/client.js && npm test",
    "verify": "node scripts/verify-host.mjs"
  }
}
