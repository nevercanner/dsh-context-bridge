{
  "name": "dsh-context-bridge",
  "version": "0.1.1",
  "description": "Automatic handoff for DSH sessions: build a compact handoff document from project facts, context summary and todos, then create and wake a new session with it.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/ui/client.js",
    "./package.json": "./package.json"
  },
  "icon": "assets/icon.svg",
  "license": "MIT",
  "author": "YG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nevercanner/dsh-context-bridge.git"
  },
  "keywords": ["dsh", "dsh-plugin", "session", "context", "handoff", "compaction", "agent"],
  "files": ["src", "types", "assets", "tests", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "engines": { "node": ">=22.18.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check src/ui/client.js && npm test",
    "verify": "node scripts/verify-host.mjs"
  }
}
